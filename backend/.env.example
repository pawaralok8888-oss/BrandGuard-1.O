
DATABASE_URL=postgresql://username:password@localhost:5432/brandguard
JWT_SECRET=replace-with-a-long-random-secret
# Optional: where uploaded content images are stored (default: backend/uploads/content_images)
# IMAGE_STORAGE_DIR=

# Alert notifications. Each channel is skipped (and recorded as skipped) until it is set.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123456789
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
# SMTP_STARTTLS=true
# APP_BASE_URL=https://your-brandguard-frontend.example
